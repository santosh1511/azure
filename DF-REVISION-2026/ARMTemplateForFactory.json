{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "DF-REVISION-2026"
		},
		"SqlServer_lnk_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'SqlServer_lnk'"
		},
		"lnk_blob_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'lnk_blob'"
		},
		"SqlServer_lnk_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "DESKTOP-OU9LNFG\\SQL2017"
		},
		"SqlServer_lnk_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "Movies"
		},
		"SqlServer_lnk_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sa"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/pipeline_rev')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "cp_OnPremToAzure",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "SqlServerSource",
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"sink": {
								"type": "DelimitedTextSink",
								"storeSettings": {
									"type": "AzureBlobStorageWriteSettings",
									"copyBehavior": "FlattenHierarchy"
								},
								"formatSettings": {
									"type": "DelimitedTextWriteSettings",
									"quoteAllText": true,
									"fileExtension": ".txt"
								}
							},
							"enableStaging": false,
							"translator": {
								"type": "TabularTranslator",
								"mappings": [
									{
										"source": {
											"name": "FilmID",
											"type": "Int32",
											"physicalType": "int"
										},
										"sink": {
											"name": "FilmID",
											"type": "String",
											"physicalType": "String"
										}
									},
									{
										"source": {
											"name": "Title",
											"type": "String",
											"physicalType": "nvarchar"
										},
										"sink": {
											"name": "Title",
											"type": "String",
											"physicalType": "String"
										}
									},
									{
										"source": {
											"name": "ReleaseDate",
											"type": "DateTime",
											"physicalType": "datetime"
										},
										"sink": {
											"name": "ReleaseDate",
											"type": "String",
											"physicalType": "String"
										}
									},
									{
										"source": {
											"name": "DirectorID",
											"type": "Int32",
											"physicalType": "int"
										},
										"sink": {
											"name": "DirectorID",
											"type": "String",
											"physicalType": "String"
										}
									},
									{
										"source": {
											"name": "StudioID",
											"type": "Int32",
											"physicalType": "int"
										},
										"sink": {
											"name": "StudioID",
											"type": "String",
											"physicalType": "String"
										}
									},
									{
										"source": {
											"name": "Review",
											"type": "String",
											"physicalType": "nvarchar"
										},
										"sink": {
											"name": "Review",
											"type": "String",
											"physicalType": "String"
										}
									},
									{
										"source": {
											"name": "CountryID",
											"type": "Int32",
											"physicalType": "int"
										},
										"sink": {
											"name": "CountryID",
											"type": "String",
											"physicalType": "String"
										}
									},
									{
										"source": {
											"name": "LanguageID",
											"type": "Int32",
											"physicalType": "int"
										},
										"sink": {
											"name": "LanguageID",
											"type": "String",
											"physicalType": "String"
										}
									},
									{
										"source": {
											"name": "GenreID",
											"type": "Int32",
											"physicalType": "int"
										},
										"sink": {
											"name": "GenreID",
											"type": "String",
											"physicalType": "String"
										}
									},
									{
										"source": {
											"name": "RunTimeMinutes",
											"type": "Int16",
											"physicalType": "smallint"
										},
										"sink": {
											"name": "RunTimeMinutes",
											"type": "String",
											"physicalType": "String"
										}
									},
									{
										"source": {
											"name": "CertificateID",
											"type": "Int32",
											"physicalType": "int"
										},
										"sink": {
											"name": "CertificateID",
											"type": "String",
											"physicalType": "String"
										}
									},
									{
										"source": {
											"name": "BudgetDollars",
											"type": "Int64",
											"physicalType": "bigint"
										},
										"sink": {
											"name": "BudgetDollars",
											"type": "String",
											"physicalType": "String"
										}
									},
									{
										"source": {
											"name": "BoxOfficeDollars",
											"type": "Int64",
											"physicalType": "bigint"
										},
										"sink": {
											"name": "BoxOfficeDollars",
											"type": "String",
											"physicalType": "String"
										}
									},
									{
										"source": {
											"name": "OscarNominations",
											"type": "Byte",
											"physicalType": "tinyint"
										},
										"sink": {
											"name": "OscarNominations",
											"type": "String",
											"physicalType": "String"
										}
									},
									{
										"source": {
											"name": "OscarWins",
											"type": "Byte",
											"physicalType": "tinyint"
										},
										"sink": {
											"name": "OscarWins",
											"type": "String",
											"physicalType": "String"
										}
									}
								],
								"typeConversion": true,
								"typeConversionSettings": {
									"allowDataTruncation": true,
									"treatBooleanAsNumber": false
								}
							}
						},
						"inputs": [
							{
								"referenceName": "ds_movies",
								"type": "DatasetReference",
								"parameters": {}
							}
						],
						"outputs": [
							{
								"referenceName": "csv_movies",
								"type": "DatasetReference",
								"parameters": {}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_movies')]",
				"[concat(variables('factoryId'), '/datasets/csv_movies')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/csv_movies')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "lnk_blob",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "AzureBlobStorageLocation",
						"fileName": "movies.csv",
						"folderPath": "Output",
						"container": "parentcontainer"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/lnk_blob')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ds_movies')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "SqlServer_lnk",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "SqlServerTable",
				"schema": [
					{
						"name": "FilmID",
						"type": "int",
						"precision": 10
					},
					{
						"name": "Title",
						"type": "nvarchar"
					},
					{
						"name": "ReleaseDate",
						"type": "datetime",
						"precision": 23,
						"scale": 3
					},
					{
						"name": "DirectorID",
						"type": "int",
						"precision": 10
					},
					{
						"name": "StudioID",
						"type": "int",
						"precision": 10
					},
					{
						"name": "Review",
						"type": "nvarchar"
					},
					{
						"name": "CountryID",
						"type": "int",
						"precision": 10
					},
					{
						"name": "LanguageID",
						"type": "int",
						"precision": 10
					},
					{
						"name": "GenreID",
						"type": "int",
						"precision": 10
					},
					{
						"name": "RunTimeMinutes",
						"type": "smallint",
						"precision": 5
					},
					{
						"name": "CertificateID",
						"type": "int",
						"precision": 10
					},
					{
						"name": "BudgetDollars",
						"type": "bigint",
						"precision": 19
					},
					{
						"name": "BoxOfficeDollars",
						"type": "bigint",
						"precision": 19
					},
					{
						"name": "OscarNominations",
						"type": "tinyint",
						"precision": 3
					},
					{
						"name": "OscarWins",
						"type": "tinyint",
						"precision": 3
					}
				],
				"typeProperties": {
					"schema": "dbo",
					"table": "Film"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/SqlServer_lnk')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/SqlServer_lnk')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "SqlServer",
				"typeProperties": {
					"server": "[parameters('SqlServer_lnk_properties_typeProperties_server')]",
					"database": "[parameters('SqlServer_lnk_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": true,
					"authenticationType": "SQL",
					"userName": "[parameters('SqlServer_lnk_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('SqlServer_lnk_password')]"
					}
				},
				"connectVia": {
					"referenceName": "IR-SelfHosted",
					"type": "IntegrationRuntimeReference"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/integrationRuntimes/IR-SelfHosted')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/lnk_blob')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobStorage",
				"typeProperties": {
					"connectionString": "[parameters('lnk_blob_connectionString')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/IR-SelfHosted')]",
			"type": "Microsoft.DataFactory/factories/integrationRuntimes",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "SelfHosted",
				"typeProperties": {}
			},
			"dependsOn": []
		}
	]
}